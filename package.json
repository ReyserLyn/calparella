{
  "name": "calparella",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler types && astro dev",
    "build": "wrangler types && astro check && astro build",
    "deploy": "wrangler types && astro build && wrangler deploy",
    "preview": "wrangler types && astro build && astro preview",
    "astro": "astro",
    "lint": "eslint . --fix",
    "check": "astro check",
    "format": "prettier . --write",
    "validate": "bun run lint && bun run check && bun run format",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply calparella --local",
    "db:migrate:prod": "wrangler d1 migrations apply calparella",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.5.0",
    "@astrojs/ts-plugin": "^1.10.7",
    "@better-auth/drizzle-adapter": "^1.6.11",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.3.1",
    "better-auth": "^1.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "wrangler": "^4.90.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.59.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.3.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.7.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript-eslint": "^8.59.3"
  },
  "overrides": {
    "vite": "^7"
  }
}
