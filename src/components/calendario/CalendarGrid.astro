---
import MonthCard from './MonthCard.astro'
import { cn } from '@/lib/utils'

interface PhotoData {
  month: number
  url?: string
  day?: number
}

interface Props {
  year: number
  calendarId?: string
  photos?: PhotoData[]
  class?: string
}

const { year, calendarId, photos = [], class: className } = Astro.props
const months = Array.from({ length: 12 }, (_, i) => i + 1)

const photoMap: Record<number, PhotoData> = {}
for (const p of photos) {
  photoMap[p.month] = p
}
---

<div class={cn('grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3', className)}>
  {
    months.map((month) => (
      <MonthCard
        month={month}
        year={year}
        calendarId={calendarId}
        photoUrl={photoMap[month]?.url}
        photoDay={photoMap[month]?.day}
      />
    ))
  }
</div>
