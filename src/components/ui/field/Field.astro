---
import { cn } from '@/lib/utils'

interface Props {
  class?: string
  id?: string
  'data-invalid'?: string | boolean
}

const { class: className, id, 'data-invalid': dataInvalid } = Astro.props
---

<div
  id={id}
  class={cn('grid gap-2', className)}
  data-invalid={dataInvalid === true || dataInvalid === 'true' ? 'true' : undefined}
>
  <slot />
</div>
