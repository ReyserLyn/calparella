---
import { Font } from 'astro:assets'
import '../styles/globals.css'
// import { ClientRouter } from 'astro:transitions'
import Background from '@/components/ui/Background.astro'
import Footer from '@/sections/Footer.astro'

interface Props {
  title: string
  description?: string
  canonical?: string
  robots?: string
  footer?: boolean
}

const {
  title,
  description = 'CalParella, el calendario compartido para parejas. Organiza momentos juntos, guarda recuerdos y celebra fechas especiales en un espacio privado solo para dos.',
  canonical,
  robots,
  footer = true,
} = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <Font cssVariable="--font-dyna" preload />
    <Font cssVariable="--font-cherry" preload />
    <Font cssVariable="--font-emilys" />

    <meta name="description" content={description} />
    <meta name="author" content="ReyserLyn" />
    {canonical && <link rel="canonical" href={canonical} />}
    {robots && <meta name="robots" content={robots} />}

    {/* <ClientRouter /> */}
  </head>

  <body>
    <div class="relative flex min-h-svh w-full flex-col">
      <Background />

      <div class="flex flex-1 flex-col">
        <slot />
      </div>
      {footer && <Footer />}
    </div>
  </body>
</html>
