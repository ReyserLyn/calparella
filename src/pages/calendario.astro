---
import Layout from '@/layouts/Layout.astro'
import Header from '@/sections/header.astro'
import { env } from 'cloudflare:workers'
import { eq } from 'drizzle-orm'
import { calendars, calendarMembers } from '@/db/schema'
import { createClient } from '@/db'
import Button from '@/components/ui/Button.astro'

if (!Astro.locals.user) {
  return Astro.redirect('/iniciar-sesion')
}

const user = Astro.locals.user
const db = createClient(env.DB)

const memberOf = await db
  .select({
    calendar: calendars,
  })
  .from(calendarMembers)
  .innerJoin(calendars, eq(calendarMembers.calendarId, calendars.id))
  .where(eq(calendarMembers.userId, user.id))
  .get()

const calendar = memberOf?.calendar ?? null
---

<Layout title="Calendario - CalParella">
  <Header />
  <main class="mx-auto max-w-2xl px-4 pt-24">
    <section class="space-y-6">
      <div class="flex items-center gap-4">
        <div
          class="font-cherry flex size-16 items-center justify-center rounded-full bg-primary/10 text-2xl font-bold text-primary"
        >
          {user.name.charAt(0).toUpperCase()}
        </div>
        <div>
          <h1 class="text-2xl font-bold">Bienvenido, {user.name}</h1>
          <p class="text-sm text-muted-foreground">{user.email}</p>
        </div>
      </div>

      {
        calendar ? (
          <div class="rounded-lg border bg-background p-6">
            <h2 class="mb-4 text-lg font-semibold">{calendar.name}</h2>
            <p class="text-sm text-muted-foreground">
              Calendario del año {calendar.year} — {calendar.isPublic ? 'Público' : 'Privado'}
            </p>
          </div>
        ) : (
          <div class="rounded-lg border bg-background p-6 text-center">
            <h2 class="mb-2 text-lg font-semibold">Todavía no tenés un calendario</h2>
            <p class="mb-4 text-sm text-muted-foreground">
              Creá uno nuevo para empezar a guardar recuerdos con tu pareja.
            </p>
            <a
              href="/calendario/nuevo"
              class="inline-flex h-9 items-center justify-center rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/80"
            >
              Crear calendario
            </a>
          </div>
        )
      }

      <Button id="logout-button">Cerrar sesión</Button>
    </section>
  </main>
</Layout>

<script>
  import { authClient } from '@/lib/auth-client'

  const logoutButton = document.getElementById('logout-button')

  logoutButton?.addEventListener('click', async () => {
    logoutButton.setAttribute('disabled', '')
    logoutButton.textContent = 'Cerrando sesión…'

    const { error } = await authClient.signOut()

    if (!error) {
      window.location.href = '/'
      return
    }

    logoutButton.removeAttribute('disabled')
    logoutButton.textContent = 'Cerrar sesión'
    console.error('Logout error:', error)
  })
</script>
