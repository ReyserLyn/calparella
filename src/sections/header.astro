---
import Logo from '@/components/branding/Logo.astro'
import Button from '@/components/ui/Button.astro'

const user = Astro.locals.user
---

<header
  class="justify-center/90 fixed top-0 z-50 mx-auto flex h-20 w-full items-center border-b select-none"
>
  <div class="flex w-full items-center justify-between px-4 md:w-full">
    <Logo iconSize={28} textSize="text-3xl" />

    <nav class="flex items-center gap-4">
      {
        user ? (
          <a
            href="/calendario"
            class="flex items-center gap-2 text-sm text-muted-foreground transition-colors hover:text-foreground"
          >
            {user.name}
          </a>
        ) : (
          <Button as="a" href="/inciar-sesion">
            Iniciar sesión
          </Button>
        )
      }
    </nav>
  </div>
</header>
