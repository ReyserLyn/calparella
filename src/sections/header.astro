---
import Logo from '@/components/branding/Logo.astro'
import Button from '@/components/ui/Button.astro'
import Avatar from '@/components/ui/avatar/Avatar.astro'
import AvatarFallback from '@/components/ui/avatar/AvatarFallback.astro'
import Icon from '@/components/ui/Icon.astro'
import Calendar02Icon from '@hugeicons/core-free-icons/Calendar02Icon'
import Logout01Icon from '@hugeicons/core-free-icons/Logout01Icon'
import AddTeamIcon from '@hugeicons/core-free-icons/AddTeamIcon'
import Settings01Icon from '@hugeicons/core-free-icons/Settings01Icon'
import UserIcon from '@hugeicons/core-free-icons/UserIcon'
import MailSend01Icon from '@hugeicons/core-free-icons/MailSend01Icon'
import Link01Icon from '@hugeicons/core-free-icons/Link01Icon'
import GlobeIcon from '@hugeicons/core-free-icons/GlobeIcon'
import CircleLock01Icon from '@hugeicons/core-free-icons/CircleLock01Icon'
import Tick04Icon from '@hugeicons/core-free-icons/Tick04Icon'
import DropdownMenu from '@/components/ui/dropdown-menu/DropdownMenu.astro'
import DropdownMenuTrigger from '@/components/ui/dropdown-menu/DropdownMenuTrigger.astro'
import DropdownMenuContent from '@/components/ui/dropdown-menu/DropdownMenuContent.astro'
import DropdownMenuItem from '@/components/ui/dropdown-menu/DropdownMenuItem.astro'
import DropdownMenuSeparator from '@/components/ui/dropdown-menu/DropdownMenuSeparator.astro'
import DropdownMenuLabel from '@/components/ui/dropdown-menu/DropdownMenuLabel.astro'
import DropdownMenuGroup from '@/components/ui/dropdown-menu/DropdownMenuGroup.astro'
import { env } from 'cloudflare:workers'
import { eq } from 'drizzle-orm'
import { calendarMembers, calendars } from '@/db/schema'
import { createClient } from '@/db'

const user = Astro.locals.user

let hasCalendar = false
let calendarSlug = ''
let calendarIsPublic = false
if (user) {
  try {
    const db = createClient(env.DB)
    const m = await db
      .select({ slug: calendars.slug, isPublic: calendars.isPublic })
      .from(calendarMembers)
      .innerJoin(calendars, eq(calendarMembers.calendarId, calendars.id))
      .where(eq(calendarMembers.userId, user.id))
      .get()
    hasCalendar = !!m
    calendarSlug = m?.slug ?? ''
    calendarIsPublic = m?.isPublic ?? false
  } catch {
    /* ignore DB errors in header */
  }
}

const tickSvgParts = Tick04Icon.map(([tag, attrs]) => {
  const attrStr = Object.entries(attrs)
    .filter(([k]) => k !== 'key')
    .map(([k, v]) => `${k}='${v}'`)
    .join(' ')
  return `<${tag} ${attrStr} />`
}).join('')

const successIconSvg = `<svg viewBox='0 0 24 24' width='14' height='14' fill='none' stroke='currentColor' stroke-width='1.5'>${tickSvgParts}</svg>`
---

<header
  class="fixed top-0 z-50 mx-auto flex h-20 w-full items-center justify-center border-b bg-background select-none"
>
  <div class="mx-auto flex w-full max-w-7xl items-center justify-between px-4">
    <Logo iconSize={28} textSize="text-3xl" />

    <nav class="flex items-center gap-4">
      {
        hasCalendar && (
          <span class="inline-flex items-center gap-1 rounded-full bg-muted px-2 py-0.5 text-[11px] text-muted-foreground">
            {calendarIsPublic ? (
              <>
                <Icon data={GlobeIcon} size={11} /> Público
              </>
            ) : (
              <>
                <Icon data={CircleLock01Icon} size={11} /> Privado
              </>
            )}
          </span>
        )
      }

      {
        user ? (
          <DropdownMenu lockScroll={false}>
            <DropdownMenuTrigger asChild>
              <button class="flex cursor-pointer items-center gap-2 rounded-full px-2 py-1 text-sm transition-colors hover:bg-muted">
                <Avatar size="sm">
                  <AvatarFallback>{user.name.charAt(0).toUpperCase()}</AvatarFallback>
                </Avatar>
                <span class="hidden text-sm font-medium md:inline">{user.name}</span>
              </button>
            </DropdownMenuTrigger>
            <DropdownMenuContent align="end" class="w-56">
              <DropdownMenuLabel>
                <div class="flex flex-col gap-0.5">
                  <span class="text-sm font-medium">{user.name}</span>
                  <span class="text-xs text-muted-foreground">{user.email}</span>
                </div>
              </DropdownMenuLabel>
              <DropdownMenuSeparator />

              <DropdownMenuGroup>
                <DropdownMenuItem class="p-0">
                  <a
                    href="/calendario"
                    class="flex w-full items-center gap-2 rounded-sm px-2 py-1.5"
                  >
                    <Icon data={Calendar02Icon} size={14} /> Ver calendario
                  </a>
                </DropdownMenuItem>
                {hasCalendar && (
                  <DropdownMenuItem class="p-0">
                    <Button
                      variant="ghost"
                      class="copy-link-btn w-full justify-start rounded-sm px-2 py-1.5 text-sm"
                      data-slug={calendarSlug}
                      data-success-icon={successIconSvg}
                    >
                      <Icon data={Link01Icon} size={14} class="size-3.5" /> Compartir
                    </Button>
                  </DropdownMenuItem>
                )}
                <DropdownMenuItem class="p-0">
                  <a
                    href="/invitaciones"
                    class="flex w-full items-center gap-2 rounded-sm px-2 py-1.5"
                  >
                    <Icon data={MailSend01Icon} size={14} /> Invitaciones
                  </a>
                </DropdownMenuItem>
                {!hasCalendar && (
                  <DropdownMenuItem class="p-0">
                    <a
                      href="/calendario"
                      class="flex w-full items-center gap-2 rounded-sm px-2 py-1.5"
                    >
                      <Icon data={AddTeamIcon} size={14} /> Crear calendario
                    </a>
                  </DropdownMenuItem>
                )}
              </DropdownMenuGroup>

              <DropdownMenuSeparator />
              <DropdownMenuGroup>
                <DropdownMenuItem disabled>
                  <Icon data={UserIcon} size={14} />
                  Editar perfil
                </DropdownMenuItem>
                <DropdownMenuItem disabled>
                  <Icon data={Settings01Icon} size={14} />
                  Configuración
                </DropdownMenuItem>
              </DropdownMenuGroup>

              <DropdownMenuSeparator />
              <DropdownMenuItem
                variant="destructive"
                id="logout-button"
                class="hover:cursor-pointer"
              >
                <Icon data={Logout01Icon} size={14} />
                Cerrar sesión
              </DropdownMenuItem>
            </DropdownMenuContent>
          </DropdownMenu>
        ) : (
          <Button as="a" href="/iniciar-sesion">
            {' '}
            Iniciar sesión{' '}
          </Button>
        )
      }
    </nav>
  </div>
</header>

<script>
  const logoutBtn = document.getElementById('logout-button')
  logoutBtn?.addEventListener('click', () => {
    import('@/lib/auth-client').then((m) => {
      m.authClient.signOut().then(({ error }) => {
        if (!error) window.location.href = '/'
      })
    })
  })

  // Copiar enlace del calendario
  const copyBtn = document.querySelector('.copy-link-btn')
  copyBtn?.addEventListener('click', async () => {
    const slug = copyBtn.getAttribute('data-slug')
    if (!slug) return
    const url = `${window.location.origin}/${slug}`
    try {
      await navigator.clipboard.writeText(url)
      const original = copyBtn.innerHTML
      const iconSvg = copyBtn.getAttribute('data-success-icon') || ''
      copyBtn.innerHTML = `${iconSvg} ¡Compartido!`
      setTimeout(() => {
        copyBtn.innerHTML = original
      }, 2000)
    } catch {
      // fallback silencioso
    }
  })
</script>
